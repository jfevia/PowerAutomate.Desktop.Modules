<#@ template language="C#" hostspecific="true" debug="true" #>
<#@ output extension=".cs" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Reflection" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#+
    string TypeName(Type type)
    {
        if (!type.IsGenericType) return type.FullName;
        var definition = type.GetGenericTypeDefinition().FullName.Split('`')[0];
        return definition + "<" + string.Join(",", type.GenericTypeArguments.Select(TypeName)) + ">";
    }
#>
<#
    WriteLine("// ---------------------------------------------------");
    WriteLine("// Copyright (c) Jesus Fernandez. All Rights Reserved.");
    WriteLine("// ---------------------------------------------------");
    WriteLine(string.Empty);
    WriteLine("//-------------------------------------------------------------------");
    WriteLine("// <auto-generated>");
    WriteLine("//     This code was generated by Actions.tt.");
    WriteLine("//");
    WriteLine("//     Changes to this file may cause incorrect behavior and will be lost if");
    WriteLine("//     the code is regenerated.");
    WriteLine("// </auto-generated>");
    WriteLine("//-------------------------------------------------------------------");
    WriteLine(string.Empty);
    WriteLine("using Microsoft.PowerPlatform.PowerAutomate.Desktop.Actions.SDK;");
    WriteLine("using Microsoft.PowerPlatform.PowerAutomate.Desktop.Actions.SDK.Attributes;");
    WriteLine("using PowerAutomate.Desktop.PetStore.Client;");
    WriteLine(string.Empty);
    WriteLine("namespace PowerAutomate.Desktop.Modules.PetStore.Actions;");
    WriteLine(string.Empty);

    const string clientProjectName = "PetStore.Client";
    const string clientTypeName = "PetStoreClient";
    var clientAssemblyFilePath = Host.ResolveAssemblyReference(@$"$(SolutionDir)samples\{clientProjectName}\bin\Debug\$(SolutionName).{clientProjectName}.dll");
    var clientAssembly = Assembly.LoadFile(clientAssemblyFilePath);
    var clientType = clientAssembly.ExportedTypes.Single(type => type.Name.Equals($"I{clientTypeName}", StringComparison.InvariantCultureIgnoreCase));
    var methods = clientType.GetMethods()
        .GroupBy(method => method.Name)
        .Select(group => group.OrderBy(method => method.GetParameters().Length).Last())
        .ToList();

    foreach (var method in methods)
    {
        var methodName = method.Name.EndsWith("Async", StringComparison.InvariantCultureIgnoreCase)
            ? method.Name.Substring(0, method.Name.LastIndexOf("Async", StringComparison.InvariantCultureIgnoreCase))
            : method.Name;
        var parameters = method.GetParameters().Where(parameter => parameter.ParameterType.Name != "CancellationToken").ToList();
        var outputType = method.ReturnType.IsGenericType ? TypeName(method.ReturnType.GenericTypeArguments.First()) : null;

        WriteLine($"[Action(Id = "{methodName}")]");
        WriteLine("[Throws(ErrorCodes.Unknown)]");
        WriteLine($"public class {methodName}Action : PetStoreActionBase");
        WriteLine("{");
        PushIndent("    ");
        WriteLine($"public {methodName}Action()");
        WriteLine("{");
        WriteLine("}");
        WriteLine(string.Empty);
        WriteLine($"public {methodName}Action(PetStoreContext context) : base(context)");
        WriteLine("{");
        WriteLine("}");
        WriteLine(string.Empty);

        var order = 1;
        foreach (var parameter in parameters)
        {
            WriteLine($"[InputArgument(Order = {order++}, Required = true)]");
            WriteLine($"public {TypeName(parameter.ParameterType)} {parameter.Name} {{ get; set; }} = null!;");
        }

        if (!string.IsNullOrEmpty(outputType))
        {
            WriteLine("[OutputArgument(Order = 1)]");
            WriteLine($"public {outputType} Result {{ get; set; }} = null!;");
        }

        WriteLine(string.Empty);
        WriteLine("protected override void Execute(IPetStoreClient client, ActionContext context)");
        WriteLine("{");
        PushIndent("    ");
        var arguments = string.Join(", ", parameters.Select(parameter => parameter.Name).Concat(new[] { "System.Threading.CancellationToken.None" }));
        if (!string.IsNullOrEmpty(outputType)) Write("Result = ");
        WriteLine($"client.{method.Name}({arguments}).GetAwaiter().GetResult();");
        PopIndent();
        WriteLine("}");
        PopIndent();
        WriteLine("}");
        WriteLine(string.Empty);
    }
#>