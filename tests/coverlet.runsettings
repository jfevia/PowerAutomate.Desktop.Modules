<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat code coverage">
                <Configuration>
                    <Format>cobertura</Format>
                    <Include>[PowerAutomate.Desktop.Modules.Windows.InputSimulation.Actions]*;[PowerAutomate.Desktop.Modules.Windows.Registry.Actions]*;[PowerAutomate.Desktop.Modules.Windows.TaskScheduler.Actions]*;[PowerAutomate.Desktop.Modules.HTML.Actions]*;[PowerAutomate.Desktop.Modules.Windows.Notifications.Actions]*;[PowerAutomate.Desktop.Modules.PowerFx.Actions]*;[PowerAutomate.Desktop.Modules.AzureKeyVault.Actions]*;[PowerAutomate.Desktop.Modules.CloudFlows.Actions]*;[PowerAutomate.Desktop.Modules.Identity.Actions]*;[PowerAutomate.Desktop.Modules.GitHub.Copilot.Actions]*;[PowerAutomate.Desktop.Modules.GitHub.Actions]*;[PowerAutomate.Desktop.Modules.ActionSelectors.Actions]*;[PowerAutomate.Desktop.Modules.AssemblyResolution.Actions]*;[PowerAutomate.Desktop.Modules.Categories.Actions]*;[PowerAutomate.Desktop.Modules.Conditionals.Actions]*;[PowerAutomate.Desktop.Modules.GettingStarted.Actions]*;[PowerAutomate.Desktop.Modules.Groups.Actions]*;[PowerAutomate.Desktop.Modules.PetStore.Actions]*;[PowerAutomate.Desktop.Modules.Tasks.Actions]*;[PowerAutomate.Desktop.Modules.OpenTibia.Actions]*;[PowerAutomate.Desktop.OpenTibia.Protocol]*;[PowerAutomate.Desktop.OpenTibia.Client]*</Include>
                    <!-- Resource accessors and interop adapters are generated or pure forwarding. -->
                    <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
                    <ExcludeByFile>**/Properties/Resources.Designer.cs</ExcludeByFile>
                    <SkipAutoProps>true</SkipAutoProps>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>
