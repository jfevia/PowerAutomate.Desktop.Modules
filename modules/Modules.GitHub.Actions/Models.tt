    private static readonly Regex SegmentSplitter = new Regex("[-_/. ]+");

    private string ToClassName(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return "Unnamed";
        var segments = SegmentSplitter.Split(raw).Where(s => s.Length > 0).Select(Capitalize);
        var name = string.Concat(segments);
        return SanitizeIdentifier(name);
    }

    private string ToPropertyName(string raw)
    {
