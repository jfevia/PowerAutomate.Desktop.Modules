        var segments = SegmentSplitter.Split(raw).Where(s => s.Length > 0).Select(Capitalize);
        var name = string.Concat(segments);
        return SanitizeIdentifier(name);
    }

    private string ToEnumMember(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return "Empty";
        var segments = SegmentSplitter.Split(raw).Where(s => s.Length > 0).Select(Capitalize);
        var name = string.Concat(segments);
        if (string.IsNullOrEmpty(name)) name = "Empty";
        if (char.IsDigit(name[0])) name = "_" + name;
        return SanitizeIdentifier(name);
