        if (schema.Type == "array")
        {
            return "List<" + (schema.Items != null ? ResolveCSharpType(schema.Items) : "JToken") + ">";
        }
        if (schema.Type == "integer") return schema.Format == "int64" ? "long?" : "int?";
        if (schema.Type == "number") return schema.Format == "float" ? "float?" : "double?";
        if (schema.Type == "boolean") return "bool?";
        if (schema.Type == "string")
        {
            if (schema.Format == "date-time" || schema.Format == "date") return "System.DateTime?";
            return "string";
        }
        if (schema.Type == "object" && (schema.Properties == null || schema.Properties.Count == 0) && schema.AdditionalProperties != null)
        {
            return "Dictionary<string, " + ResolveCSharpType(schema.AdditionalProperties) + ">";
        }
        return "JToken";
    }

    private static readonly Regex SegmentSplitter = new Regex("[-_/. ]+");

    private string ToClassName(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return "Unnamed";
        var segments = SegmentSplitter.Split(raw).Where(s => s.Length > 0).Select(Capitalize);
        return SanitizeIdentifier(string.Concat(segments));
    }

    private string ToPropertyName(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return "Value";
        var segments = SegmentSplitter.Split(raw).Where(s => s.Length > 0).Select(Capitalize);
        var name = SanitizeIdentifier(string.Concat(segments));
        if (PadReservedPropertyNames.Contains(name)) name += "Argument";
        return name;
    }

    private string ToEnumMember(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return "Empty";
        var segments = SegmentSplitter.Split(raw).Where(s => s.Length > 0).Select(Capitalize);
        var name = string.Concat(segments);
        if (string.IsNullOrEmpty(name)) name = "Empty";
        if (char.IsDigit(name[0])) name = "_" + name;
        return SanitizeIdentifier(name);
    }

    private string ToCategoryName(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return "General";
        var segments = SegmentSplitter.Split(raw).Where(s => s.Length > 0).Select(Capitalize);
        return string.Concat(segments);
    }

    private string LocationToGroup(string location)
    {
        switch (location)
        {
            case "Path": return "Path";
            case "Query": return "Query";
            case "Header":
            case "Cookie":
                return "Header";
            default:
                return "Query";
        }
    }

    private string MakeUnique(string candidate, HashSet<string> used)
    {
        if (used.Add(candidate)) return candidate;
        var n = 2;
        while (!used.Add(candidate + n)) n++;
        return candidate + n;
    }

    private static string Capitalize(string s)
    {
        if (string.IsNullOrEmpty(s)) return s;
        return char.ToUpperInvariant(s[0]) + (s.Length > 1 ? s.Substring(1) : string.Empty);
    }

    private static string SanitizeIdentifier(string s)
    {
        if (string.IsNullOrEmpty(s)) return "Unnamed";
        var sb = new StringBuilder();
        foreach (var c in s)
        {
            if (char.IsLetterOrDigit(c) || c == '_') sb.Append(c);
            else sb.Append('_');
        }
        var result = sb.ToString();
        if (result.Length == 0 || char.IsDigit(result[0])) result = "_" + result;
        return CSharpKeywords.Contains(result) ? "@" + result : result;
    }

