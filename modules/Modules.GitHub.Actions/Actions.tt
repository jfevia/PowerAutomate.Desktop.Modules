    private string ResolveResponseType(OpenApiOperation op)
    {
        if (op.Responses == null) return null;
        var success = op.Responses
            .Where(r => r.Key.StartsWith("2"))
            .OrderBy(r => r.Key)
            .FirstOrDefault();
