        var content = success.Value.Content;
        if (content == null) return null;
        var jsonContent = content.FirstOrDefault(kv => string.Equals(kv.Key, "application/json", StringComparison.OrdinalIgnoreCase));
        if (jsonContent.Value == null || jsonContent.Value.Schema == null) return null;
        return ResolveCSharpType(jsonContent.Value.Schema);
    }

    private string ResolveCSharpType(OpenApiSchema schema)
